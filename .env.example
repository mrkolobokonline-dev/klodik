# Скопируй в .env и впиши свои значения. Файл .env НЕ коммитить.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_SMART=
OLLAMA_MODEL_VISION=

# Адреса проверки ботов (через запятую), например https://my-bot.example/health
BOTS_URLS=

# Воздушные тревоги: бесплатный токен с alerts.in.ua (по запросу), регион как на сайте
ALERTS_TOKEN=
ALERTS_REGION=м. Київ
